# Docker Compose variable overrides for local MySQL development.
# Copy to .env.docker and load it with:
# docker compose --env-file .env.docker up -d

MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=automation_hub
MYSQL_USER=automation_hub
MYSQL_PASSWORD=change-this-user-password
MYSQL_PORT=3306

# Python 애플리케이션에서 사용할 연결 URL입니다.
DATABASE_URL=mysql+pymysql://automation_hub:change-this-user-password@127.0.0.1:3306/automation_hub
