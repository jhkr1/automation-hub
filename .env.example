# ── 네이버 Open API (namuwiki_trend용) ──
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# ── Gemini (공통) ──
GEMINI_API_KEY=your_gemini_api_key

# ── OpenAI (선택적 TrendReason Provider) ──
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna

# ── Google Finance ──
# 사용자가 수정하는 Watchlist 예시이며, 실행 시 강제되는 기본 목록이 아닙니다.
STOCK_SYMBOLS=NVDA:NASDAQ,PLTR:NASDAQ,005930:KRX,000660:KRX

# ── 설정 ──
LOG_LEVEL=INFO

# ── Database ──
DATABASE_URL=mysql+pymysql://automation_hub:change-this-user-password@127.0.0.1:3306/automation_hub
