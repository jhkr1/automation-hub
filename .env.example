# ── 네이버 Open API (namuwiki_trend용) ──
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# ── Gemini (job/profile-specific; values must never be committed) ──
# Keys in the same Google Cloud Project share quota. Separate Projects are
# required to isolate production and test quota.
GEMINI_NAMUWIKI_API_KEY_PROD=
GEMINI_GOOGLE_FINANCE_API_KEY_PROD=
GEMINI_NAMUWIKI_API_KEY_TEST=
GEMINI_GOOGLE_FINANCE_API_KEY_TEST=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_PROJECT_PROFILE_PROD=production
GEMINI_PROJECT_PROFILE_TEST=test
# Deprecated compatibility only for direct legacy Generator use; cron must not use it.
# GEMINI_API_KEY=

# ── OpenAI (선택적 TrendReason Provider) ──
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna

# ── Google Finance ──
# 사용자가 수정하는 Watchlist 예시이며, 실행 시 강제되는 기본 목록이 아닙니다.
STOCK_SYMBOLS=NVDA:NASDAQ,PLTR:NASDAQ,005930:KRX,000660:KRX

# ── TAGO Bus PoC (production Pipeline does not use this value) ──
# Station and Arrival API calls use one portal-issued Service Key.
TAGO_SERVICE_KEY=

# ── Gyeonggi Bus Production ──
# Public-data-portal decoding Service Key; requests serializes it via params.
GYEONGGI_SERVICE_KEY=

# ── TAGO Bus PoC (production Provider does not use these values) ──
# 공공데이터포털에서 발급한 API별 Service Key와, 실제 확인한 도시/정류소 ID를 설정합니다.
# 값은 source control에 커밋하지 않습니다.
TAGO_ARRIVAL_SERVICE_KEY=
TAGO_STATION_SERVICE_KEY=
# WGS84 coordinates for the TAGO GPS nearby-station PoC.
TAGO_LATITUDE=
TAGO_LONGITUDE=
TAGO_CITY_CODE=
TAGO_NODE_ID=

# ── ODsay Route Planning ──
ODSAY_API_KEY=

# ── 설정 ──
LOG_LEVEL=INFO

# ── Database ──
DATABASE_URL=mysql+pymysql://automation_hub:change-this-user-password@127.0.0.1:3306/automation_hub
