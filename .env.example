# ── 네이버 Open API (namuwiki_trend용) ──
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# ── Gemini (job/profile-specific; values must never be committed) ──
# Keys in the same Google Cloud Project share quota. Separate Projects are
# required to isolate production and test quota.
GEMINI_NAMUWIKI_API_KEY_PROD=
GEMINI_GOOGLE_FINANCE_API_KEY_PROD=
GEMINI_NAMUWIKI_API_KEY_TEST=
GEMINI_GOOGLE_FINANCE_API_KEY_TEST=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_PROJECT_PROFILE_PROD=production
GEMINI_PROJECT_PROFILE_TEST=test
# Deprecated compatibility only for direct legacy Generator use; cron must not use it.
# GEMINI_API_KEY=

# ── OpenAI (선택적 TrendReason Provider) ──
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna

# ── Google Finance ──
# 사용자가 수정하는 Watchlist 예시이며, 실행 시 강제되는 기본 목록이 아닙니다.
STOCK_SYMBOLS=NVDA:NASDAQ,PLTR:NASDAQ,005930:KRX,000660:KRX

# ── 설정 ──
LOG_LEVEL=INFO

# ── Database ──
DATABASE_URL=mysql+pymysql://automation_hub:change-this-user-password@127.0.0.1:3306/automation_hub
